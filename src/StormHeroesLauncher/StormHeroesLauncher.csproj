<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HOSLauncher</AssemblyName><RootNamespace>StormHeroesLauncher</RootNamespace>
    <Product>HOSLauncher</Product><AssemblyTitle>HOSLauncher</AssemblyTitle>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Launcher.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.3.0-dev.6</Version><InformationalVersion>0.3.0-dev.6</InformationalVersion><ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildId" Value="0.3.0-dev.6" />
    <AssemblyMetadata Include="DeveloperObserver" Value="$(DeveloperObserver)" />
    <Resource Include="Assets\Launcher.ico" />
    <PackageReference Include="SharpCompress" Version="[0.50.4]" />
    <None Update="uu-cli.settings.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="'$(DeveloperObserver)' != 'true'">
    <Compile Remove="Observer\**\*.cs" />
  </ItemGroup>
  <Target Name="ValidateObserverFlag" BeforeTargets="CoreCompile">
    <Error Condition="'$(DeveloperObserver)' != 'true' and '$(DeveloperObserver)' != 'false'" Text="DeveloperObserver must be true or false." />
  </Target>
</Project>
